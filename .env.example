# Modular RAG Engine: copy to .env.local and supply your own values.
NVIDIA_STRUCTURED_OUTPUT_METHOD=json_schema
NVIDIA_GENERATION_OPTIONS={"reasoning_effort":"low","reasoning_budget":1024}
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b
API_ADMIN_TOKEN=
API_USER_TOKEN=
CORS_ORIGINS=[]
PARSER_PROVIDER=structured
EMBEDDER_PROVIDER=sentence_transformers
VECTOR_STORE_PROVIDER=qdrant
LLM_PROVIDER=nvidia_nim
QUEUE_PROVIDER=rq
# Compose overrides these to internal service names.
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# Measured recall-oriented default; individual queries may override it.
RETRIEVAL_TOP_K=8

# User credentials are denied access outside this explicit list. Admin stays privileged.
API_USER_USE_CASES=["synthetic"]
