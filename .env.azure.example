# Azure profile: substitute your own endpoints, deployment names and credentials.
PARSER_PROVIDER=structured
EMBEDDER_PROVIDER=azure_openai
VECTOR_STORE_PROVIDER=azure_search
LLM_PROVIDER=azure_openai
QUEUE_PROVIDER=service_bus
SHARED_STATE_PROVIDER=azure_blob
ORIGINALS_PROVIDER=azure_blob
AZURE_OPENAI_ENDPOINT=https://YOUR-ACCOUNT.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-GENERATION-DEPLOYMENT
AZURE_OPENAI_JUDGE_DEPLOYMENT=YOUR-JUDGE-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
AZURE_GENERATION_MODEL_IDENTITY=gpt-4o:2024-11-20
AZURE_JUDGE_MODEL_IDENTITY=gpt-4o:2024-11-20
AZURE_EMBEDDING_MODEL_IDENTITY=text-embedding-3-small:1
AZURE_EMBEDDING_DIMENSIONS=1536
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=rag-chunks
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
AZURE_SERVICE_BUS_NAMESPACE=YOUR-NAMESPACE.servicebus.windows.net
AZURE_SERVICE_BUS_QUEUE=rag-jobs
# Set AZURE_CLIENT_ID to the user-assigned managed identity in Azure.
API_ADMIN_TOKEN=
API_USER_TOKEN=
API_USER_USE_CASES=["synthetic"]
CORS_ORIGINS=[]
RETRIEVAL_TOP_K=8
PROVIDER_MIN_INTERVAL_SECONDS=65
